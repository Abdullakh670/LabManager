@page "/my-bookings"
@rendermode InteractiveServer
@using LabManager.Domain.Entities
@using LabManager.WebUI.Services
@inject LabManager.Application.Services.IBookingService BookingService
@inject CurrentUserState UserState
@inject NavigationManager Navigation

<PageTitle>Мои бронирования</PageTitle>

@if (!ready)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Мои бронирования</h1>
        <a href="/" class="btn btn-outline-secondary btn-sm">К оборудованию</a>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-info">@message</div>
    }

    @if (bookings.Count == 0)
    {
        <p class="text-muted">У вас пока нет бронирований.</p>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr><th>Оборудование</th><th>Начало</th><th>Окончание</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var b in bookings)
                {
                    <tr>
                        <td>@b.Equipment.Name</td>
                        <td>@b.StartTime.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@b.EndTime.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-danger" @onclick="() => Cancel(b.Id)">Отменить</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private List<Booking> bookings = new();
    private string message = "";
    private bool ready;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await UserState.InitializeAsync();
        if (!UserState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await Reload();
        ready = true;
        StateHasChanged();
    }

    private async Task Reload() =>
        bookings = await BookingService.GetUserBookingsAsync(UserState.Current!.Id);

    private async Task Cancel(int bookingId)
    {
        var result = await BookingService.CancelBookingAsync(bookingId, UserState.Current!.Id);
        message = result.Success ? "Бронь отменена." : result.Error ?? "Не удалось отменить.";
        await Reload();
    }
}