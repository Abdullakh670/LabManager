@page "/"
@using LabManager.Infrastructure.Data
@using LabManager.Domain.Entities
@inject LabManager.Application.Services.IEquipmentService EquipmentService
@inject ApplicationDbContext DbContext

<PageTitle>Оборудование</PageTitle>

<h1>Доступное оборудование</h1>

@if (equipments == null)
{
    <p><em>Загрузка...</em></p>
}

else
{
    <div class="row">
        @foreach (var equipment in equipments)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@equipment.Name</h5>
                        <p class="card-text text-muted">@equipment.Description</p>
                       
                        <div class="mb-3">
                            <strong>Статус: </strong>
                            @if (equipment.Status.ToString() == "Available")
                            {
                                <span class="badge bg-success">Доступно</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">На обслуживании</span>
                            }
                        </div>

                        <!-- Кнопка бронирования -->
                        <button class="btn btn-primary w-100" 
        disabled="@(equipment.Status.ToString() != "Available")"
        @onclick="() => BookEquipment(equipment.Id)">
    Забронировать
</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private async Task BookEquipment(int equipmentId)
    {
        // Вызываем твой метод из EquipmentService
        bool success = await EquipmentService.BookEquipmentAsync(
            equipmentId, 
            "Abdullakh", // Пока захардкодим твое имя как арендатора для теста
            DateTime.Now, 
            DateTime.Now.AddHours(2)
        );

        if (success)
        {
            // Если бронь прошла успешно, заново грузим список из базы SQLite, 
            // чтобы интерфейс сразу обновился и кнопка отключилась
            equipments = await EquipmentService.GetAllEquipmentAsync();
        }
    }
    private List<Equipment>? equipments;

    protected override void OnInitialized()
    {
        // Получаем список оборудования из базы данных
        equipments = DbContext.Equipments.ToList();
    }
}