@page "/"
@rendermode InteractiveServer
@using LabManager.Domain.Entities
@using LabManager.Domain.Enums
@using LabManager.WebUI.Components
@using LabManager.WebUI.Services
@using Microsoft.AspNetCore.SignalR.Client
@inject LabManager.Application.Services.IEquipmentService EquipmentService
@inject CurrentUserState UserState
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>Оборудование</PageTitle>

@if (!ready)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Доступное оборудование</h1>
        <div>
            <span class="me-2">@UserState.Current!.FullName (@UserState.Current.Role)</span>
            <a href="/my-bookings" class="btn btn-outline-primary btn-sm me-2">Мои бронирования</a>
            @if (UserState.IsAdmin)
            {
                <a href="/admin" class="btn btn-outline-primary btn-sm me-2">Админ-панель</a>
            }
            <button class="btn btn-outline-secondary btn-sm" @onclick="Logout">Выйти</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-info">@message</div>
    }

    @if (equipments == null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <div class="row">
            @foreach (var equipment in equipments)
            {
                <div class="col-md-4 mb-4">
                    <ResourceCard Item="equipment" OnBook="OpenCalendar" />
                </div>
            }
        </div>
    }

    @if (selected is not null)
    {
        <BookingCalendar Title="@selected.Name"
                         Error="@calendarError"
                         OnConfirm="ConfirmBooking"
                         OnCancel="CloseCalendar" />
    }
}

@code {
    private List<Equipment>? equipments;
    private Equipment? selected;
    private string? calendarError;
    private string message = "";
    private bool ready;
    private HubConnection? hubConnection;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Проверяем, кто вошёл (sessionStorage доступен только после отрисовки)
        await UserState.InitializeAsync();
        if (!UserState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        equipments = await EquipmentService.GetAllEquipmentAsync();
        ready = true;
        StateHasChanged();

        await ConnectToHubAsync();
    }

    private async Task ConnectToHubAsync()
    {
        try
        {
            // Blazor Server подключается к собственному хабу через localhost
            var baseUri = new Uri(Navigation.BaseUri);
            var hubUrl = $"{baseUri.Scheme}://localhost:{baseUri.Port}/bookinghub";

            hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl)
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On("EquipmentUpdated", async () =>
            {
                equipments = await EquipmentService.GetAllEquipmentAsync();
                await InvokeAsync(StateHasChanged);
            });

            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            // Страница должна работать, даже если real-time временно недоступен
            Console.WriteLine($"SignalR недоступен: {ex.Message}");
        }
    }

    // Нажали «Забронировать» на карточке: открываем окно выбора времени
    private void OpenCalendar(int equipmentId)
    {
        selected = equipments?.FirstOrDefault(e => e.Id == equipmentId);
        calendarError = null;
        message = "";
    }

    private void CloseCalendar()
    {
        selected = null;
        calendarError = null;
    }

    // Подтвердили время в календаре: бронируем через сервис
    private async Task ConfirmBooking(BookingRange range)
    {
        if (selected is null) return;
try
        {
            bool success = await EquipmentService.BookEquipmentAsync(
                selected.Id,
                UserState.Current!.Id,
                range.Start,
                range.End);

            if (success)
            {
                message = $"«{selected.Name}» забронировано: {range.Start:dd.MM.yyyy HH:mm} - {range.End:HH:mm}.";
                selected = null;
                calendarError = null;
                equipments = await EquipmentService.GetAllEquipmentAsync();

                if (hubConnection is { State: HubConnectionState.Connected })
                    await hubConnection.SendAsync("NotifyChanged");
            }
            else
            {
                calendarError = "Не удалось забронировать: это время уже занято или оборудование недоступно.";
            }
        }
        catch (Exception ex)
        {
            calendarError = $"Ошибка: {ex.Message}";
        }
    }

    private async Task Logout()
    {
        await UserState.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
            await hubConnection.DisposeAsync();
    }
}