@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="alert alert-danger m-4" role="alert">
                        <h4 class="alert-heading">Упс, что-то пошло не так 🛠️</h4>
                        <p>Произошла непредвиденная ошибка. Возможно, пропала связь с сервером или базой данных.</p>
                        <hr>
                        <p class="mb-0">
                            Попробуйте <a href="/" class="alert-link">обновить страницу</a> или вернуться на главную.
                        </p>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

<div id="blazor-error-ui" style="display: none;">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>